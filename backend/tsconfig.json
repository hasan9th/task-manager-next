{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
        "sourceMap": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
}